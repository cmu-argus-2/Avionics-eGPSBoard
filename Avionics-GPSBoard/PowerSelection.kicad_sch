		(uuid "12294bf6-6fdb-42db-bb65-038feaed2376")
	)
	(text_box "Design Requirements:\n1) [System voltage] VBATT = 6.0V - 8.4V\n2) [System overvoltage] VBATT_OV = 9.0V (600mV more than lipo max)\n3) [System max current] ILIM = 2.5A\n4) [Soft start current] I_SS = 0.5A\n4) [Load transient blanking interval] t_iob = 1ms\n\nOvervoltage:\n\nVBATT_OV = 1.2V * (1 + (R39 / R40)\nR39 = 649K\nR40 = 100K\nVBATT_OV = 8.988V\n\nSoft Start:\nI_SS = C_bulk * SR\nC_bulk ~= 80uF (20uF for 4 DCDCs)\nSR = 6.25V/ms\nC61 = 2000 / SR ~= 330pF\n\nSoft Start Power Dissipation:\nPD_SS = (I_SS * VBATT) / 2 = 2.1W\n\nCurrent Limit:\nR41 = 3334 / 2.5A ~= 1.33K\n\nOvercurrent Blanking Interval:\nC62 = (t_iob * 1.8uA) / 1.51V ~= 1.2nF\n\n\nFault Logic:\n- Overcurrent response = circuit breaker\n- Fault response = latch-off\n"
		(exclude_from_sim no)
		(at 198.12 66.04 0)
		(size 73.66 69.3764)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 194 1)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 194 1)
			)
			(justify left top)
		)
		(uuid "3e099c8c-c428-47b2-9446-ad07f86750ce")
	)
	(text_box "Power monitor placed on BUS 3V3 supply to allow continuous current monitoring when system is unpowered."
		(exclude_from_sim no)
		(at 290.195 123.8881 0)
		(size 58.42 8.0376)
		(margins 0.9525 0.9525 0.9525 0.9525)
