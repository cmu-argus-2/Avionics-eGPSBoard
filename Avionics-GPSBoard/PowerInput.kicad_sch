	(text "POWER MONITOR"
		(exclude_from_sim no)
		(at 15.24 95.25 0)
		(effects
			(font
				(size 1.524 1.524)
				(thickness 0.1905)
			)
			(justify left top)
		)
		(uuid "eb49f9ff-ec93-485b-8106-2b26963bfe9f")
	)
	(text_box "Design Requirements:\n1) [System voltage] VBATT = 6.0V - 8.4V\n2) [System overvoltage] VBATT_OV = 9.0V (600mV more than lipo max)\n3) [System max current] ILIM = 2.75A\n4) [Soft start current] I_SS = 0.50A\n4) [Load transient blanking interval] t_iob = 2ms\n\nOvervoltage:\n\nVBATT_OV = 1.2V * (1 + (RA / RB)\nRA = 330K\nRB = 51K\nVBATT_OV = 8.965V\n\nSoft Start:\nI_{SS} = C_bulk * SR\nC_{bulk} ~= 80uF (20uF for 4 DCDCs)\nSR = 6.25V/ms\nC_{S} = 2000 / SR ~= 330pF\n\nSoft Start Power Dissipation:\nPD_{SS} = (I_SS * VBATT) / 2 = 2.1W\n\nCurrent Limit:\nR_{ILM} = 3334 / 2.75A ~= 1.2k\n\nOvercurrent Blanking Interval:\nC_{O} = (t_iob * 1.8uA) / 1.51V ~= 2.2nF\n\n\nFault Logic:\n- Overcurrent response = circuit breaker\n- Fault response = latch-off\n"
		(exclude_from_sim no)
		(at 209.55 94.4536 0)
		(size 73.66 69.3764)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 194 1)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 194 1)
			)
			(justify left top)
		)
		(uuid "3e099c8c-c428-47b2-9446-ad07f86750ce")
	)
	(text_box "Power monitor placed on BUS 3V3 supply to allow continuous current monitoring even when system is unpowered."
		(exclude_from_sim no)
		(at 13.97 176.1124 0)
		(size 58.42 8.0376)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 194 1)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 194 1)
			)
			(justify left top)
		)
		(uuid "a4b982da-507a-4639-ab87-74233334f05c")
	)
	(text_box "[System max current] ILIM = 2.5A\n[Max shunt voltage] V_shuntmax = 81.92 (from INA226 datasheet)\n\nV_shunt = 2.5A * 10m = 25mV"
