				(color 0 0 194 1)
			)
			(justify left top)
		)
		(uuid "a49c39ff-8438-43bc-9c9d-b1f806701041")
	)
	(text_box "Regulator Iq = 1uA\nSupervisor Iq = 12uA\nMax VSYS = 8.4V\n\n8.4V * 13uA = 109uW"
