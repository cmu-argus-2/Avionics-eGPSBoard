		)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 194 1)
			)
			(justify left top)
		)
		(uuid "7c995bd6-a652-4506-8b6a-6a29d3ad5108")
	)
	(text_box "FPGA Reset Process:\n1) Pulse FPGA_nPROG LOW\n2) Hold FPGA_nINIT LOW to keep FPGA in reset\n\nFPGA_nINIT is bidirectional (driven LOW by FPGA during a fault condition) so it needs to be isolated from the rest of the reset signals. Both FPGA_nINIT and FPGA_nPROG can be driven by the E1."
		(exclude_from_sim no)
		(at 111.76 177.8 0)
		(size 53.34 18.2607)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 194 1)
